		<service>
			<name>aws-highavail</name>
			<description><![CDATA[AWS High Availability Periodic Monitor]]></description>
			<startcmd>exec(&quot;/usr/local/bin/minicron 60 /var/run/aws_highavail.pid /usr/local/pkg/aws_highavail/aws_highavail_periodic&quot;);</startcmd>
			<stopcmd>exec(&quot;/bin/pkill -F /var/run/aws_highavail.pid&quot;);</stopcmd>
			<custom_php_service_status_command>&quot;&quot;; $output=[];  @exec(&quot;/bin/pgrep -F /var/run/aws_highavail.pid&quot;, $output, $status); $rc = ($status == 0);</custom_php_service_status_command>
		</service>
